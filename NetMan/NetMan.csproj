<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NetMan</AssemblyName>
    <Copyright>Copyright 2026 Xeno Innovations, Inc.</Copyright>
    <PackageProjectUrl>https://github.com/DamianSuess/NetMan-Game</PackageProjectUrl>
    <Description>Side scrolling game (engine) written in .NET</Description>
    <BaseOutputPath>../output</BaseOutputPath>
    <FileVersion>0.2.2</FileVersion>
    <AssemblyVersion>0.2.2</AssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NetManDistribution)' == 'true'">
    <DefineConstants>$(DefineConstants);NETMAN_DISTRIBUTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Levels\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(NetManDistribution)' == 'true'">
    <Compile Remove="SelfTests.cs;GraphicsTests.cs;ArtExporter.cs" />
    <Content Update="Assets\Previews\**\*;Assets\README.md" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
